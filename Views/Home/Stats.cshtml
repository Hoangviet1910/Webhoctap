@model HoangViet.Models.StatsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Bảng Thống Kê Năng Lực & Tiến Độ";
}

<div class="container-fluid py-4 px-3 px-lg-5" style="max-width: 1440px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge hv-track-pill-intern px-3 py-1 fw-bold mb-2">COMPETENCY ANALYTICS</span>
            <h1 class="h3 fw-bold mb-1" style="color: #0F172A;">Bảng Thống Kê Năng Lực & Tiến Độ Học Tập — Hoàng Việt</h1>
            <p class="text-secondary mb-0">
                Toàn bộ 6 nhóm kỹ năng khởi đầu ở mức <strong>0%</strong> và tăng dần theo thời gian thực khi bạn hoàn thành bài tập ở từng Bài học con.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" asp-route-track="INTERN_TRACK" class="btn btn-hv-orange px-3 py-2">
                <i class="bi bi-play-circle-fill me-1"></i>Quay lại Học tập
            </a>
            <form asp-controller="Home" asp-action="ResetProgress" method="post"
                  onsubmit="return confirm('Bạn có chắc chắn muốn đặt lại toàn bộ tiến độ và điểm năng lực về 0%?');">
                <button type="submit" class="btn btn-hv-outline px-3 py-2">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset về 0%
                </button>
            </form>
        </div>
    </div>

    <!-- 3 Thẻ Tóm tắt Tiến độ 2 Menu -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="cp-section-card h-100 mb-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-semibold">TỔNG TIẾN ĐỘ HỆ THỐNG</span>
                    <span class="badge bg-success font-mono">@Model.OverallProgressPercent%</span>
                </div>
                <div class="h2 fw-bold font-mono mb-2" style="color: #0F172A;">
                    @Model.CompletedLessonsCount / @Model.TotalLessonsCount <span class="fs-6 text-secondary">bài học con</span>
                </div>
                <div class="progress hv-progress-track-lg">
                    <div class="progress-bar hv-progress-bar-primary" style="width: @(Model.OverallProgressPercent)%;"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cp-section-card h-100 mb-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-primary small fw-semibold">MENU 1: LỘ TRÌNH ĐI THỰC TẬP (5 CHỦ ĐỀ)</span>
                    <i class="bi bi-lightning-charge-fill text-primary"></i>
                </div>
                <div class="h2 fw-bold font-mono mb-2" style="color: #0F172A;">
                    @Model.InternTrackCompleted / @Model.InternTrackTotal <span class="fs-6 text-secondary">bài học con</span>
                </div>
                <a asp-controller="Home" asp-action="Index" asp-route-track="INTERN_TRACK" class="small text-primary text-decoration-none fw-semibold">
                    Mở Lộ trình Thực tập <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cp-section-card h-100 mb-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold" style="color: #7C3AED;">MENU 2: LỘ TRÌNH HỌC CHI TIẾT (16 CHỦ ĐỀ)</span>
                    <i class="bi bi-journal-bookmark-fill" style="color: #7C3AED;"></i>
                </div>
                <div class="h2 fw-bold font-mono mb-2" style="color: #0F172A;">
                    @Model.DetailedTrackCompleted / @Model.DetailedTrackTotal <span class="fs-6 text-secondary">bài học con</span>
                </div>
                <a asp-controller="Home" asp-action="Index" asp-route-track="DETAILED_TRACK" class="small text-decoration-none fw-semibold" style="color: #7C3AED;">
                    Mở Lộ trình Chi tiết 16 Chủ đề <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Hàng Biểu đồ: Mạng nhện (Radar) + Ô tròn (Doughnut) + Biểu đồ Đường (Timeline Line Chart) -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="cp-section-card h-100 mb-0">
                <h2 class="h6 fw-bold mb-3" style="color: #0F172A;">
                    <i class="bi bi-diagram-3-fill text-primary me-2"></i>1. Biểu đồ Mạng Nhện (Radar Chart - 6 Kỹ Năng)
                </h2>
                <div style="height: 300px; position: relative;">
                    <canvas id="statsRadarChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cp-section-card h-100 mb-0">
                <h2 class="h6 fw-bold mb-3" style="color: #0F172A;">
                    <i class="bi bi-pie-chart-fill me-2" style="color: #7C3AED;"></i>2. Biểu đồ Ô Tròn (Doughnut Chart - Tỷ Trọng Kỹ Năng)
                </h2>
                <div style="height: 300px; position: relative;">
                    <canvas id="statsDoughnutChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cp-section-card h-100 mb-0">
                <h2 class="h6 fw-bold mb-3" style="color: #0F172A;">
                    <i class="bi bi-graph-up-arrow text-success me-2"></i>3. Biểu đồ Đường Theo Ngày Học (Timeline Line Chart)
                </h2>
                <div style="height: 300px; position: relative;">
                    <canvas id="statsTimelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết từng nhóm kỹ năng -->
    <div class="cp-section-card">
        <h2 class="h5 fw-bold mb-3" style="color: #0F172A;">Chi tiết 6 nhóm năng lực C# Fullstack .NET 10</h2>
        <div class="row g-3">
            @foreach (var skill in Model.SkillMetrics)
            {
                <div class="col-md-6">
                    <div class="hv-skill-matrix-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold" style="color: #0F172A;">@skill.SkillName</span>
                            <span class="font-mono fw-bold @(skill.CurrentScore > 0 ? "text-primary" : "text-secondary")">
                                @skill.CurrentScore / @skill.MaxScore điểm (@skill.CurrentScore%)
                            </span>
                        </div>
                        <div class="progress hv-progress-track-lg">
                            <div class="progress-bar hv-progress-bar-primary"
                                 role="progressbar"
                                 style="width: @(skill.CurrentScore)%;">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const labels = @Html.Raw(JsonSerializer.Serialize(Model.SkillMetrics.Select(s => s.SkillName)));
            const scores = @Html.Raw(JsonSerializer.Serialize(Model.SkillMetrics.Select(s => s.CurrentScore)));
            const timelineLabels = @Html.Raw(JsonSerializer.Serialize(Model.TimelinePoints.Select(t => t.DateLabel)));
            const timelineCounts = @Html.Raw(JsonSerializer.Serialize(Model.TimelinePoints.Select(t => t.CompletedLessonsCount)));

            // 1. Radar Chart (Modern Light Mode Palette)
            const radarCtx = document.getElementById('statsRadarChart');
            if (radarCtx && window.Chart) {
                new Chart(radarCtx, {
                    type: 'radar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Điểm năng lực hiện tại (%)',
                            data: scores,
                            backgroundColor: 'rgba(37, 99, 235, 0.16)',
                            borderColor: '#2563EB',
                            pointBackgroundColor: '#059669',
                            pointBorderColor: '#FFFFFF',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 100,
                                ticks: { stepSize: 20, color: '#64748B', backdropColor: 'transparent' },
                                grid: { color: '#E2E8F0' },
                                angleLines: { color: '#E2E8F0' },
                                pointLabels: { color: '#334155', font: { size: 12, weight: '600' } }
                            }
                        },
                        plugins: { legend: { labels: { color: '#334155' } } }
                    }
                });
            }

            // 2. Doughnut Chart
            const doughnutCtx = document.getElementById('statsDoughnutChart');
            if (doughnutCtx && window.Chart) {
                const allZero = scores.every(s => s === 0);
                new Chart(doughnutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: allZero ? ['Chưa hoàn thành bài tập (0%)'] : labels,
                        datasets: [{
                            data: allZero ? [100] : scores,
                            backgroundColor: allZero
                                ? ['#E2E8F0']
                                : ['#2563EB', '#059669', '#0284C7', '#7C3AED', '#D97706', '#DB2777'],
                            borderColor: '#FFFFFF',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: { position: 'bottom', labels: { color: '#334155', boxWidth: 12 } }
                        }
                    }
                });
            }

            // 3. Timeline Line Chart
            const lineCtx = document.getElementById('statsTimelineChart');
            if (lineCtx && window.Chart) {
                new Chart(lineCtx, {
                    type: 'line',
                    data: {
                        labels: timelineLabels,
                        datasets: [{
                            label: 'Số bài học & bài tập hoàn thành',
                            data: timelineCounts,
                            borderColor: '#059669',
                            backgroundColor: 'rgba(5, 150, 105, 0.14)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4,
                            pointBackgroundColor: '#2563EB',
                            pointBorderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                suggestedMax: 5,
                                ticks: { stepSize: 1, color: '#64748B' },
                                grid: { color: '#E2E8F0' }
                            },
                            x: {
                                ticks: { color: '#334155' },
                                grid: { color: '#F1F5F9' }
                            }
                        },
                        plugins: { legend: { labels: { color: '#334155' } } }
                    }
                });
            }
        });
    </script>
}
