@{
    var currentTrack = ViewData["CurrentTrack"]?.ToString() ?? "INTERN_TRACK";
    var progressPercent = ViewData["OverallProgressPercent"] != null ? Convert.ToInt32(ViewData["OverallProgressPercent"]) : 0;
    var completedCount = ViewData["CompletedLessonsCount"] != null ? Convert.ToInt32(ViewData["CompletedLessonsCount"]) : 0;
    var totalCount = ViewData["TotalLessonsCount"] != null ? Convert.ToInt32(ViewData["TotalLessonsCount"]) : 0;
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hoàng Việt (.NET 10 Learning Platform)</title>

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Course Player & Interactive Step Boxes CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="minimalist-course-body">
    <!-- ================= TOP HEADER ================= -->
    <header class="cp-top-header">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index" asp-route-track="INTERN_TRACK" class="cp-brand-link">
                <div class="cp-brand-logo">HV</div>
                <div>
                    <div class="cp-brand-name">Hoàng Việt</div>
                    <div class="cp-brand-sub">C# ASP.NET Core 10.0 Learning Platform</div>
                </div>
            </a>
        </div>

        <!-- 2 MENU CHÍNH TÁCH BIỆT HOÀN TOÀN TRÊN HEADER -->
        <nav class="cp-track-switcher">
            <a asp-controller="Home" asp-action="Index" asp-route-track="INTERN_TRACK"
               class="cp-track-tab @(currentTrack == "INTERN_TRACK" ? "active" : "")">
                <i class="bi bi-lightning-charge-fill me-1"></i>
                <span>Menu 1: Lộ trình Đi Thực Tập (5 Chủ đề cốt lõi - Đọc Code & Luồng BE/Web API)</span>
            </a>
            <a asp-controller="Home" asp-action="Index" asp-route-track="DETAILED_TRACK"
               class="cp-track-tab @(currentTrack == "DETAILED_TRACK" ? "active" : "")">
                <i class="bi bi-journal-bookmark-fill me-1"></i>
                <span>Menu 2: Lộ trình Học Chi Tiết (Đầy đủ 16 Chủ đề Fullstack .NET từ gốc)</span>
            </a>
        </nav>

        <!-- THANH TIẾN ĐỘ TỔNG (MẶC ĐỊNH 0%) + NÚT THỐNG KÊ + NÚT PHÒNG MENTOR AI 2D -->
        <div class="d-flex align-items-center gap-2">
            <div class="cp-overall-progress-box d-none d-xl-flex" title="Tiến độ hoàn thành khóa học">
                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                    <span class="small text-secondary">Tiến độ:</span>
                    <span id="headerProgressText" class="font-mono fw-bold small text-success">
                        @progressPercent% (@completedCount/@totalCount bài)
                    </span>
                </div>
                <div class="progress w-100" style="height: 6px; background: #0F172A;">
                    <div id="headerProgressBar" class="progress-bar" role="progressbar"
                         style="width: @(progressPercent)%; background: linear-gradient(90deg, #F97316, #10B981); transition: width 0.4s ease;">
                    </div>
                </div>
            </div>

            <a asp-controller="Home" asp-action="Stats"
               class="btn btn-sm @(currentTrack == "STATS" ? "btn-hv-green" : "btn-hv-outline") px-3 py-2">
                <i class="bi bi-pie-chart-fill me-1"></i>Bảng Thống Kê
            </a>

            <a asp-controller="AIStudio" asp-action="Index"
               class="btn btn-sm @(currentTrack == "AISTUDIO" ? "btn-hv-orange" : "btn-hv-outline") px-3 py-2">
                <span>🤖 Phòng Mentor AI 2D</span>
            </a>
        </div>
    </header>

    <!-- ================= MAIN WORKSPACE ================= -->
    <main class="cp-workspace">
        @RenderBody()
    </main>

    <!-- GLOBAL FLOATING 2D AI MASCOT WIDGET -->
    <partial name="_AIMascotWidget" />

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
